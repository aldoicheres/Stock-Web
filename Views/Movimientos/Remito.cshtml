@model StockWeb.Models.Remito

<div class="card my-3">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Remito N.º @Model.Id</h4>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <strong>Fecha:</strong> @Model.Fecha
            </div>
            <div class="col-md-4">
                <strong>Tipo de movimiento:</strong> @Model.TipoMovimiento
            </div>
            <div class="col-md-4">
                <strong>Retira:</strong> @Model.PersonaRetira
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="mt-2"><strong>Observaciones:</strong> @Model.Observaciones</div>
        }
    </div>
</div>

<table class="table table-bordered my-3">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Producto / Mercadería</th>
            <th class="text-center">Cantidad</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Detalles)
        {
            <tr>
                <td>@item.ProductosId</td>
                <td>
                    <strong>@item.Producto?.Nombre</strong><br />
                    <small class="text-muted">@item.Producto?.Descripcion</small>
                </td>
                <td class="text-center fs-5 fw-bold">@item.Cantidad</td>
            </tr>
        }
    </tbody>
</table>
