@model StockWeb.Models.Producto
@{
   ViewData["Title"] = "Nuevo Productos / Mercaderia";
   Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Nuevo Producto</h2>
    <form asp-action="Crear" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <input asp-for="Descripcion" class="form-control" />
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CategoriasId" class="form-label">Categoría</label>
            <select asp-for="CategoriasId" class="form-control" asp-items="ViewBag.CategoriasId">
                <option value="">-- Seleccionar Categoría --</option>
            </select>
            <span asp-validation-for="CategoriasId" class="text-danger"></span>

        </div>
        <div class="mb-3">
            <label asp-for="StockActual" class="form-label">Stock Actual</label>
            <input asp-for="StockActual" class="form-control" />
            <span asp-validation-for="StockActual" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="ProductosLista" class="btn btn-secondary">Cancelar</a>
    </form>
</div>