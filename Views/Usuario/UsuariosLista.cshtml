@model IEnumerable<Usuario>

@{
    ViewData["Title"] = "Administración de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>👤 Listado de Usuarios</h2>
        <a asp-action="Crear" class="btn btn-success">➕ Agregar Usuario</a>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Última Modificación</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.USUARIO</td>
                        <td>@user.EMAIL</td>
                        <td>
                            @if (user.ROL == "1")
                            {
                                <span class="badge bg-danger">Administrador</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Operador</span>
                            }
                        </td>
                        <td>@user.ULTIMA_MODIFICACION</td>
                        <td class="text-center">
                            <a asp-action="Editar" asp-route-id="@user.Id" class="btn btn-warning btn-sm">✏️ Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
